# ============================================
# Libraries
# ============================================
library(ggplot2)
library(dplyr)
library(patchwork)
library(viridis)

# ============================================
# Load model-ready data
# ============================================
combined <- read.csv("/Users/sargon/Desktop/masters/final_figures/model_dat.csv")

combined$YEAR       <- factor(combined$YEAR_f)
combined$SITE_CLEAN <- factor(
  combined$SITE_CLEAN,
  levels = c("QUBS", "Moores Tract", "Cow Island", "Blueberry Hill", "Red")
)
combined$SEX <- factor(combined$SEX, levels = c("F", "M"))

# ============================================
# Fixed, bold year colours (one per year)
# ============================================
year_levels <- sort(unique(as.character(combined$YEAR)))
n_years     <- length(year_levels)

year_cols <- viridis(n_years, option = "D")
names(year_cols) <- year_levels

print(year_cols)

# ============================================
# Shared theme
# ============================================
shared_theme <- theme_minimal() +
  theme(
    axis.text.x      = element_text(size = 10, angle = 45, hjust = 1),
    axis.text.y      = element_text(size = 10),
    axis.title       = element_text(size = 13),
    strip.text       = element_text(size = 11, face = "bold"),
    legend.position  = "none",
    panel.grid.minor = element_blank()
  )

# ============================================
# GRAPH 1: YEAR × ORDINAL DATE
# plain points (no jitter) + dashed faint trendline
# ============================================
p_date <- ggplot(combined, aes(x = ordinal_date, y = Pop2, fill = YEAR)) +
  geom_point(size = 1.3, shape = 21,
             colour = "black", stroke = 0.15) +
  geom_smooth(method = "lm", formula = y ~ x, se = FALSE,
              colour = "grey40", linewidth = 0.7,
              linetype = "dashed", alpha = 0.4) +
  scale_fill_manual(values = year_cols, drop = FALSE) +
  facet_grid(YEAR ~ ., scales = "free_y", space = "free_y") +
  scale_y_continuous(limits = c(0, 1), breaks = c(0, 1)) +
  scale_x_continuous(breaks = seq(0, 365, 60)) +
  labs(x = "Ordinal date (day of year)", y = "Q score") +
  shared_theme

print(p_date)

# ============================================
# GRAPH 2: YEAR × SITE (jitter on x only)
# ============================================
p_site <- ggplot(combined, aes(x = SITE_CLEAN, y = Pop2, fill = YEAR)) +
  geom_boxplot(alpha = 0.7, outlier.shape = NA, na.rm = TRUE,
               colour = "black") +
  geom_jitter(width = 0.15, height = 0, size = 0.9,
              shape = 21, colour = "black", stroke = 0.15) +
  scale_fill_manual(values = year_cols, drop = FALSE) +
  facet_grid(YEAR ~ ., scales = "free_y", space = "free_y") +
  scale_y_continuous(limits = c(0, 1), breaks = c(0, 1)) +
  labs(x = "Site", y = "Q score") +
  shared_theme

print(p_site)

# ============================================
# GRAPH 3: YEAR × SEX (jitter on x only)
# ============================================
p_sex <- ggplot(combined, aes(x = SEX, y = Pop2, fill = YEAR)) +
  geom_boxplot(alpha = 0.7, outlier.shape = NA, na.rm = TRUE,
               colour = "black") +
  geom_jitter(width = 0.15, height = 0, size = 0.9,
              shape = 21, colour = "black", stroke = 0.15) +
  scale_fill_manual(values = year_cols, drop = FALSE) +
  facet_grid(YEAR ~ ., scales = "free_y", space = "free_y") +
  scale_y_continuous(limits = c(0, 1), breaks = c(0, 1)) +
  labs(x = "Sex", y = "Q score") +
  shared_theme

print(p_sex)

# ============================================
# Save
# ============================================
ggsave("/Users/sargon/Desktop/masters/final_figures/Q_by_date_year_bold.pdf",
       p_date, width = 8, height = 16)
ggsave("/Users/sargon/Desktop/masters/final_figures/Q_by_site_year_bold.pdf",
       p_site, width = 10, height = 16)
ggsave("/Users/sargon/Desktop/masters/final_figures/Q_by_sex_year_bold.pdf",
       p_sex, width = 6, height = 16)

cat("\n========== DONE ==========\n")
