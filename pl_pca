# ======================================================
# PCA with Q-score colour gradient (viridis) + species legend
# ======================================================

library(viridis)

setwd("/Users/sargon/Desktop/masters/final_figures")

# ======================================================
# 1. Point estimates + sample names
# ======================================================
pntest <- read.table("pntest_mean_gl.txt", header = FALSE)
sample_names <- read.table("inds_peromyscus_clean.txt",
                           header = FALSE, stringsAsFactors = FALSE)$V1

# ======================================================
# 2. PCA
# ======================================================
pntest_t <- t(pntest)
constant_cols <- apply(pntest_t, 2,
                       function(x) var(x, na.rm = TRUE) == 0 | all(is.na(x)))
pntest_var <- pntest_t[, !constant_cols]

pca <- prcomp(pntest_var, center = TRUE, scale = TRUE)
var_exp <- (pca$sdev^2 / sum(pca$sdev^2)) * 100

pca_scores <- as.data.frame(pca$x)
colnames(pca_scores) <- paste0("PC", 1:ncol(pca_scores))
pca_scores$Sample <- sample_names

# ======================================================
# 3. Q scores
# ======================================================
q_data <- read.table("peromyscus_clean_admixture_ready.2.Q", header = FALSE)
colnames(q_data) <- c("Pop1", "Pop2")

fam_data <- read.table("peromyscus_clean_admixture_ready.fam", header = FALSE)
colnames(fam_data) <- c("FID", "IID", "PAT", "MAT", "SEX_PLINK", "PHENOTYPE")
q_data$Sample <- fam_data$IID

stopifnot(nrow(pca_scores) == nrow(q_data))

if (all(pca_scores$Sample == q_data$Sample)) {
  pca_scores$Pop2 <- q_data$Pop2
} else {
  pca_scores <- merge(pca_scores, q_data[, c("Sample", "Pop2")],
                      by = "Sample", all.x = TRUE)
}
pca_scores$Pop2 <- pmin(pmax(pca_scores$Pop2, 0), 1)

pca_scores <- pca_scores[order(pca_scores$Pop2), ]

# ======================================================
# 4. Colours
# ======================================================
pal <- viridis(100, option = "D")
col_idx <- cut(pca_scores$Pop2,
               breaks = seq(0, 1, length.out = 101),
               include.lowest = TRUE, labels = FALSE)
point_cols <- pal[col_idx]

# ======================================================
# 5. Plot — reserve right margin for legend
# ======================================================
par(mar = c(5, 4, 2, 11), xpd = NA)

plot(pca_scores$PC1, pca_scores$PC2,
     col  = point_cols,
     pch  = 19,
     cex  = 0.8,
     xlab = paste0("PC1 (", round(var_exp[1], 2), "%)"),
     ylab = paste0("PC2 (", round(var_exp[2], 2), "%)"),
     main = "")

# ======================================================
# 6. Legend — vertical viridis bar + species names
# ======================================================
# Push the legend further right (increase multiplier below)
x_left   <- par("usr")[2] + 0.10 * diff(par("usr")[1:2])   # was 0.02
bar_w    <- 0.03  * diff(par("usr")[1:2])
y_bottom <- par("usr")[3] + 0.20 * diff(par("usr")[3:4])
y_top    <- par("usr")[3] + 0.80 * diff(par("usr")[3:4])

# Gradient bar
ys <- seq(y_bottom, y_top, length.out = 101)
for (i in 1:100) {
  rect(x_left, ys[i], x_left + bar_w, ys[i + 1],
       col = pal[i], border = NA, xpd = NA)
}
rect(x_left, y_bottom, x_left + bar_w, y_top,
     col = NA, border = "black", lwd = 0.8, xpd = NA)

# ---- Species labels (SWAPPED) ----
# Bottom = Pop2 = 0 → P. leucopus
text(x = x_left + bar_w / 2,
     y = y_bottom - 0.04 * diff(par("usr")[3:4]),
     labels = expression(italic("P. leucopus")),
     adj = c(0.5, 1), cex = 0.9, xpd = NA)

# Top = Pop2 = 1 → P. maniculatus
text(x = x_left + bar_w / 2,
     y = y_top + 0.04 * diff(par("usr")[3:4]),
     labels = expression(italic("P. maniculatus")),
     adj = c(0.5, 0), cex = 0.9, xpd = NA)

# Reset margin for the scree plot
par(mar = c(5, 4, 4, 2) + 0.1, xpd = FALSE)

# ======================================================
# 7. Scree plot
# ======================================================
plot(1:min(20, length(var_exp)), var_exp[1:min(20, length(var_exp))],
     type = "b", pch = 19, col = "red",
     xlab = "Principal Component",
     ylab = "Variance Explained (%)",
     main = "Scree Plot")

# ======================================================
# 8. Summary
# ======================================================
cat("PC1:", round(var_exp[1], 2), "%\n")
cat("PC2:", round(var_exp[2], 2), "%\n")
cat("PC3:", round(var_exp[3], 2), "%\n")
