# ============================================
# Libraries
# ============================================
library(glmmTMB)
library(ggplot2)
library(patchwork)

# ============================================
# Load data + create year variables
# ============================================
model_dat <- readRDS("/Users/sargon/Desktop/masters/final_figures/model_dat.rds")

model_dat$YEAR_f   <- factor(model_dat$YEAR_f)
model_dat$year_num <- as.numeric(as.character(model_dat$YEAR_f))
model_dat$year_c   <- model_dat$year_num - min(model_dat$year_num) + 1   # 1..8

# ============================================
# Fit the model (year coded 1-8)
# ============================================
set.seed(123)
beta_pop2_num <- glmmTMB(
  Pop2 ~ ordinal_date + year_c + SEX + (1 | SITE_CLEAN),
  data = model_dat,
  family = beta_family(link = "logit"),
  na.action = na.omit
)
summary(beta_pop2_num)

# ============================================
# Manual predictions on the response scale,
# with 95% CIs via predict(se.fit = TRUE)
# ============================================
newdat_base <- data.frame(
  ordinal_date = mean(model_dat$ordinal_date, na.rm = TRUE),
  year_c       = mean(model_dat$year_c),
  SEX          = factor("F", levels = levels(model_dat$SEX))
)

# Helper: link-scale prediction + 95% CI -> response scale
add_ci <- function(nd) {
  pr <- predict(beta_pop2_num, newdata = nd, re.form = NA,
                type = "link", se.fit = TRUE)
  nd$predicted <- plogis(pr$fit)
  nd$conf.low  <- plogis(pr$fit - 1.96 * pr$se.fit)
  nd$conf.high <- plogis(pr$fit + 1.96 * pr$se.fit)
  nd
}

# --- Date ---
nd_date <- newdat_base[rep(1, 100), ]
nd_date$ordinal_date <- seq(min(model_dat$ordinal_date, na.rm = TRUE),
                            max(model_dat$ordinal_date, na.rm = TRUE),
                            length.out = 100)
nd_date <- add_ci(nd_date)

# --- Year (1-8) ---
nd_year <- newdat_base[rep(1, 8), ]
nd_year$year_c <- 1:8
nd_year <- add_ci(nd_year)

# --- Sex ---
nd_sex <- newdat_base[rep(1, 2), ]
nd_sex$SEX <- factor(c("F", "M"), levels = levels(model_dat$SEX))
nd_sex <- add_ci(nd_sex)

# --- Site ---
# Site is a random effect with ~0 variance; predict at the population level
# for each site so we can still show a 95% CI on the red dot.
nd_site <- newdat_base[rep(1, length(unique(model_dat$SITE_CLEAN))), ]
nd_site$SITE_CLEAN <- unique(model_dat$SITE_CLEAN)
nd_site <- add_ci(nd_site)

# ============================================
# Plot 1: ordinal date (jitter + 95% CI ribbon + trendline)
# ============================================
p_date <- ggplot() +
  geom_jitter(data = model_dat, aes(x = ordinal_date, y = Pop2),
              width = 0.5, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_ribbon(data = nd_date,
              aes(x = ordinal_date, ymin = conf.low, ymax = conf.high),
              fill = "red", alpha = 0.15) +
  geom_line(data = nd_date, aes(x = ordinal_date, y = predicted),
            colour = "red", linewidth = 1) +
  labs(x = "Ordinal date",
       y = "Q score") +
  theme_bw()

# ============================================
# Plot 2: year (jitter + 95% CI ribbon + trendline)
# ============================================
p_year <- ggplot() +
  geom_jitter(data = model_dat, aes(x = year_c, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_ribbon(data = nd_year,
              aes(x = year_c, ymin = conf.low, ymax = conf.high),
              fill = "red", alpha = 0.15) +
  geom_line(data = nd_year, aes(x = year_c, y = predicted),
            colour = "red", linewidth = 1) +
  scale_x_continuous(breaks = 1:8, labels = 2016:2023) +
  labs(x = "Year",
       y = "Q score") +
  theme_bw()

# ============================================
# Plot 3: sex (jitter + 95% CI error bar + point)
# ============================================
p_sex <- ggplot() +
  geom_jitter(data = model_dat, aes(x = SEX, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_errorbar(data = nd_sex,
                aes(x = SEX, ymin = conf.low, ymax = conf.high),
                width = 0.1, colour = "red", linewidth = 0.8) +
  geom_point(data = nd_sex, aes(x = SEX, y = predicted),
             colour = "red", size = 3) +
  labs(x = "Sex",
       y = "Q score") +
  theme_bw()

# ============================================
# Plot 4: site (jitter + 95% CI error bar + point)
# ============================================
p_site <- ggplot() +
  geom_jitter(data = model_dat, aes(x = SITE_CLEAN, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_errorbar(data = nd_site,
                aes(x = SITE_CLEAN, ymin = conf.low, ymax = conf.high),
                width = 0.1, colour = "red", linewidth = 0.8) +
  geom_point(data = nd_site, aes(x = SITE_CLEAN, y = predicted),
             colour = "red", size = 3) +
  labs(x = "Site",
       y = "Q score") +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 30, hjust = 1))

# ============================================
# Combine and save
# ============================================
combined_plot <- (p_date | p_year) / (p_sex | p_site)
print(combined_plot)

ggsave("/Users/sargon/Desktop/masters/final_figures/Pop2_model_plots_year_continuous.pdf",
       combined_plot, width = 12, height = 8)
