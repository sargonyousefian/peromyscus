# ============================================
# Libraries
# ============================================
library(glmmTMB)
library(ggplot2)
library(patchwork)

# ============================================
# Load data + fit model
# ============================================
model_dat <- readRDS("/Users/sargon/Desktop/masters/final_figures/model_dat.rds")
model_dat$year_num <- as.numeric(as.character(model_dat$YEAR_f))

set.seed(123)
beta_pop2_num <- glmmTMB(
  Pop2 ~ ordinal_date + year_num + SEX + (1 | SITE_CLEAN),
  data = model_dat,
  family = beta_family(link = "logit"),
  na.action = na.omit
)
summary(beta_pop2_num)

# ============================================
# Manual predictions (no CIs) — response scale
# ============================================
newdat_base <- data.frame(
  ordinal_date = mean(model_dat$ordinal_date, na.rm = TRUE),
  year_num     = mean(model_dat$year_num),
  SEX          = factor("F", levels = levels(model_dat$SEX))
)

# --- Date ---
nd_date <- newdat_base[rep(1, 100), ]
nd_date$ordinal_date <- seq(min(model_dat$ordinal_date, na.rm = TRUE),
                            max(model_dat$ordinal_date, na.rm = TRUE),
                            length.out = 100)
nd_date$predicted <- plogis(predict(beta_pop2_num, newdata = nd_date,
                                    re.form = NA, type = "link"))

# --- Year ---
nd_year <- newdat_base[rep(1, 8), ]
nd_year$year_num <- sort(unique(model_dat$year_num))
nd_year$predicted <- plogis(predict(beta_pop2_num, newdata = nd_year,
                                    re.form = NA, type = "link"))

# --- Sex ---
nd_sex <- newdat_base[rep(1, 2), ]
nd_sex$SEX <- factor(c("F", "M"), levels = levels(model_dat$SEX))
nd_sex$predicted <- plogis(predict(beta_pop2_num, newdata = nd_sex,
                                   re.form = NA, type = "link"))

# ============================================
# Plot 1: ordinal date (jitter + trendline)
# ============================================
p_date <- ggplot() +
  geom_jitter(data = model_dat, aes(x = ordinal_date, y = Pop2),
              width = 0.5, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_line(data = nd_date, aes(x = ordinal_date, y = predicted),
            colour = "red", linewidth = 1) +
  labs(x = "Ordinal date (day of year)",
       y = "Pop2 ancestry proportion") +
  theme_bw()

# ============================================
# Plot 2: year (jitter + trendline)
# ============================================
p_year <- ggplot() +
  geom_jitter(data = model_dat, aes(x = year_num, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_line(data = nd_year, aes(x = year_num, y = predicted),
            colour = "red", linewidth = 1) +
  scale_x_continuous(breaks = sort(unique(model_dat$year_num))) +
  labs(x = "Year",
       y = "Pop2 ancestry proportion") +
  theme_bw()

# ============================================
# Plot 3: sex (jitter + point)
# ============================================
p_sex <- ggplot() +
  geom_jitter(data = model_dat, aes(x = SEX, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  geom_point(data = nd_sex, aes(x = SEX, y = predicted),
             colour = "red", size = 3) +
  labs(x = "Sex",
       y = "Pop2 ancestry proportion") +
  theme_bw()

# ============================================
# Plot 4: site (jitter only — random effect is ~0)
# ============================================
p_site <- ggplot() +
  geom_jitter(data = model_dat, aes(x = SITE_CLEAN, y = Pop2),
              width = 0.15, height = 0.01, alpha = 0.3,
              shape = 21, fill = "grey60", size = 1.8) +
  labs(x = "Site",
       y = "Pop2 ancestry proportion") +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 30, hjust = 1))

# ============================================
# Combine and save
# ============================================
combined_plot <- (p_date | p_year) / (p_sex | p_site)
print(combined_plot)

ggsave("/Users/sargon/Desktop/masters/final_figures/Pop2_model_plots_year_continuous.pdf",
       combined_plot, width = 12, height = 8)
