# ============================================
cat("\n\n========== OVERALL SUMMARY ==========")
cat("\nTotal individuals in Q file:", nrow(q_data))
cat("\nTotal individuals in FAM file:", nrow(fam_data))
cat("\nTotal individuals in metadata:", nrow(metadata))
cat("\nSuccessfully matched individuals:", nrow(combined %>% filter(!is.na(SEX))))
cat("\n")
